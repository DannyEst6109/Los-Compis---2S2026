
// 03  Expresiones aritméticas


let a: integer = 10;
let b: integer = 3;
let c: integer = 2;

let suma: integer = a + b;
let resta: integer = a - b;
let producto: integer = a * b;
let cociente: integer = a / b;
let residuo: integer = a % b;

let precedencia: integer = a + b * c;
let agrupada: integer = (a + b) * c;
let asociatividad: integer = a - b - c;
let negativo: integer = -(a + b);
let constante: integer = -5 * c;

let saludo: string = "Hola " + "mundo";

