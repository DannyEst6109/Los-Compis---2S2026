
// 05 Arreglos


let numeros: integer[] = [10, 20, 30];
let matriz: integer[][] = [[1, 2], [3, 4]];
let vacio: integer[] = [];

let primero: integer = numeros[0];
let i: integer = 1;
numeros[i] = numeros[i + 1] * 2;

let celda: integer = matriz[1][0];
matriz[0][1] = celda + 1;

